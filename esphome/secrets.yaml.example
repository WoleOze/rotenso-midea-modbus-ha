# Skopiuj ten plik jako secrets.yaml (obok pompa-modbus.yaml) i uzupełnij wartości. secrets.yaml jest w .gitignore.
wifi_ssid: ""            # nazwa sieci Wi-Fi 2,4 GHz
wifi_password: ""        # hasło Wi-Fi
# Klucz szyfrowania API (32 bajty w base64). Wygeneruj np.:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   albo: openssl rand -base64 32
# Ten sam klucz podajesz w Home Assistant przy dodawaniu urządzenia ESPHome.
api_key: ""
ap_password: ""          # hasło punktu dostępowego awaryjnego (min. 8 znaków), gdy moduł nie złapie Wi-Fi
